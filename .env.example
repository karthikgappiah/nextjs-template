# Neon Postgres. Run `neon claim create --env-pull` to generate these (see README).
# Pooled connection: use for the app at runtime.
DATABASE_URL=
# Direct connection: use for schema migrations.
DATABASE_URL_UNPOOLED=
# Neon Auth (Managed Better Auth). Written by `neon deploy` / `neon env pull`.
NEON_AUTH_BASE_URL=
# Secret for session cookies, 32+ characters. Generate with `openssl rand -base64 32`.
NEON_AUTH_COOKIE_SECRET=
# Public origin of the app, used in email links (no trailing slash).
APP_URL=
# Signs mailing list confirm/unsubscribe links. Generate with `openssl rand -base64 32`.
MAILING_LIST_SECRET=
# Resend: sends mailing list confirmation emails. Unset in development logs them instead.
RESEND_API_KEY=
# Verified Resend sender, e.g. `Example <news@example.com>`.
MAILING_LIST_FROM=
# Upstash Redis for rate limiting. Unset in development skips limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
