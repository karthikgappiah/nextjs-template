# Neon Postgres. Run `neon claim create --env-pull` to generate these (see README).
# Pooled connection: use for the app at runtime.
DATABASE_URL=
# Direct connection: use for schema migrations.
DATABASE_URL_UNPOOLED=
# Neon Auth (Managed Better Auth). Written by `neon deploy` / `neon env pull`.
NEON_AUTH_BASE_URL=
# Secret for session cookies, 32+ characters. Generate with `openssl rand -base64 32`.
NEON_AUTH_COOKIE_SECRET=
